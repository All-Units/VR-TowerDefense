--- !u!1001 &471973004874488536
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 2987907895356296607}
    m_Modifications:
    - target: {fileID: 368829892518402859, guid: 3328e31852b13f442baec7aa9562cb29,
        type: 3}
      propertyPath: m_text
      value: "Sacred Valley has been saved\u2026at least, what\u2019s left of it. 
        With his home finally secure, Lindon delves deep into the ancient labyrinth,
        seeking long-lost Soulsmithing knowledge and the secret to destroying the
        Dreadgods. Monarchs plot against him and against each other, unaware of the
        threats gathering in realms beyond.  Far above Lindon and the Monarchs and
        the Dreadgods, another war is waged. Suriel and the Abidan clash against
        the Mad King and his forces in a battle for the fate of many worlds.  And
        if it is lost, Cradle will be destroyed."
      objectReference: {fileID: 0}
    - target: {fileID: 368829892518402859, guid: 3328e31852b13f442baec7aa9562cb29,
        type: 3}
